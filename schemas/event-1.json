{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://probandia.replit.app/schemas/event-1.json",
  "title": "events.jsonl line",
  "description": "One event of a research's log.",
  "type": "object",
  "required": [
    "id",
    "ts",
    "pass",
    "actor",
    "type",
    "payload",
    "prev"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "$ref": "#/$defs/ulid"
    },
    "ts": {
      "$ref": "#/$defs/timestamp"
    },
    "pass": {
      "type": "integer",
      "minimum": 0
    },
    "actor": {
      "$ref": "#/$defs/actor"
    },
    "type": {
      "enum": [
        "pass.started",
        "pass.ended",
        "volet.opened",
        "instruction.added",
        "plan.made",
        "search.logged",
        "evidence.recorded",
        "fact.asserted",
        "fact.revised",
        "fact.retracted",
        "hypothesis.opened",
        "hypothesis.updated",
        "hypothesis.closed",
        "negative.recorded",
        "erratum.recorded",
        "section.added",
        "section.replaced",
        "section.moved",
        "section.merged",
        "branch.added",
        "mode.changed",
        "language.changed",
        "verify.run",
        "library.used",
        "question.added",
        "question.updated",
        "research.closed",
        "analysis.recorded",
        "proof.recorded",
        "matrix.justified",
        "fact.checked",
        "workshop.pushed"
      ]
    },
    "payload": {
      "type": "object"
    },
    "refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "supersedes": {
      "$ref": "#/$defs/nulid"
    },
    "prev": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "actor": {
      "type": "object",
      "required": [
        "harness",
        "agent"
      ],
      "additionalProperties": false,
      "properties": {
        "harness": {
          "type": "string"
        },
        "agent": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "session": {
          "type": "string"
        }
      }
    },
    "nulid": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "ulid": {
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    }
  }
}
