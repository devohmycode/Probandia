{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://probandia.replit.app/schemas/searches-1.json",
  "title": "searches.yaml",
  "description": "Family index: searches.yaml.",
  "type": "object",
  "required": [
    "schema",
    "searches"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": 1
    },
    "searches": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/search"
      }
    }
  },
  "$defs": {
    "nday": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "nslug": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "search": {
      "type": "object",
      "required": [
        "id",
        "ts",
        "kind",
        "query",
        "result"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/searchid"
        },
        "ts": {
          "$ref": "#/$defs/timestamp"
        },
        "research": {
          "$ref": "#/$defs/nslug"
        },
        "pass": {
          "type": [
            "integer",
            "null"
          ]
        },
        "kind": {
          "enum": [
            "native",
            "provider",
            "archive"
          ]
        },
        "engine": {
          "type": [
            "string",
            "null"
          ]
        },
        "family": {
          "type": [
            "string",
            "null"
          ]
        },
        "query": {
          "type": "string"
        },
        "variants": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "filters": {
          "type": [
            "object",
            "null"
          ]
        },
        "window": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "from": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "to": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "places": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          ]
        },
        "results": {
          "type": [
            "integer",
            "null"
          ]
        },
        "result": {
          "enum": [
            "positive",
            "negative",
            "partial",
            "empty",
            "failed"
          ]
        },
        "failure": {
          "type": [
            "string",
            "null"
          ]
        },
        "support": {
          "enum": [
            "image",
            "index",
            null
          ]
        },
        "witness": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "passed",
                "ts"
              ],
              "additionalProperties": false,
              "properties": {
                "operation": {
                  "type": "string"
                },
                "args": {
                  "type": [
                    "object",
                    "null"
                  ]
                },
                "expected": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "passed": {
                  "type": "boolean"
                },
                "ts": {
                  "$ref": "#/$defs/timestamp"
                }
              }
            }
          ]
        },
        "source_state": {
          "type": [
            "string",
            "null"
          ]
        },
        "recheck_if": {
          "type": [
            "string",
            "null"
          ]
        },
        "recheck_after": {
          "$ref": "#/$defs/nday"
        },
        "units": {
          "type": [
            "number",
            "null"
          ]
        },
        "proves": {
          "enum": [
            "result",
            "proof",
            null
          ]
        },
        "expected": {
          "type": [
            "string",
            "null"
          ],
          "description": "a negative that proves (proves: proof): why the record should exist in what was searched (T249, P-3)"
        }
      }
    },
    "searchid": {
      "type": "string",
      "pattern": "^s-[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
