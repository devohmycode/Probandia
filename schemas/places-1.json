{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://probandia.replit.app/schemas/places-1.json",
  "title": "places.yaml",
  "description": "Family index: places.yaml.",
  "type": "object",
  "required": [
    "schema",
    "places"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": 1
    },
    "places": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/place"
      }
    }
  },
  "$defs": {
    "nslug": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "place": {
      "type": "object",
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "names_as_written": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "current_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "type": {
          "enum": [
            "parish",
            "commune",
            "hamlet",
            "town",
            "county",
            "country"
          ]
        },
        "parent": {
          "$ref": "#/$defs/nslug"
        },
        "insee": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "code": {
                  "type": "string"
                },
                "valid_from": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "valid_to": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          ]
        },
        "gov": {
          "type": [
            "string",
            "null"
          ]
        },
        "geonames": {
          "type": [
            "string",
            "null"
          ]
        },
        "wikidata": {
          "type": [
            "string",
            "null"
          ]
        },
        "whg": {
          "type": [
            "string",
            "null"
          ]
        },
        "lat": {
          "type": [
            "number",
            "null"
          ]
        },
        "lon": {
          "type": [
            "number",
            "null"
          ]
        },
        "jurisdictions": {
          "type": "array",
          "description": "the jurisdictions the place came under, and when (GPS2)",
          "items": {
            "$ref": "#/$defs/jurisdiction"
          }
        },
        "repositories": {
          "type": "array",
          "description": "where its records are kept (GPS2)",
          "items": {
            "$ref": "#/$defs/repository"
          }
        },
        "guide": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "built": {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                },
                "sources": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "copied_from": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          ],
          "description": "when the locality guide was built, and from what (places guide)"
        }
      }
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "jurisdiction": {
      "type": "object",
      "required": [
        "level",
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "level": {
          "enum": [
            "commune",
            "municipality",
            "canton",
            "district",
            "arrondissement",
            "department",
            "region",
            "province",
            "state",
            "country",
            "parish",
            "parish-group",
            "deanery",
            "diocese",
            "church-province",
            "bailliage",
            "seneschalsy",
            "generality",
            "court"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "place": {
          "$ref": "#/$defs/nslug",
          "description": "the jurisdiction as a place of places.yaml"
        },
        "from": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^-?[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$",
          "description": "first year or day; null when unknown"
        },
        "to": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^-?[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$",
          "description": "last year or day; null when it still holds or is unknown"
        },
        "source": {
          "type": [
            "string",
            "null"
          ],
          "description": "where it comes from, such as insee-cog, gov:object_1275820, wikidata:Q1399380"
        },
        "derived": {
          "type": "boolean",
          "description": "true when inferred by a stated rule, not read in a source"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "repository": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "archive": {
          "type": [
            "string",
            "null"
          ],
          "description": "its id in catalogues/archives.yaml, when it has one"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "holdings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "type"
            ],
            "additionalProperties": false,
            "properties": {
              "type": {
                "type": "string",
                "minLength": 1,
                "description": "a source type, as in the coverage of catalogues/archives.yaml"
              },
              "years": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "integer"
                }
              },
              "reference": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        },
        "note": {
          "type": "string"
        }
      }
    }
  }
}
