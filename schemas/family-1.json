{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://probandia.replit.app/schemas/family-1.json",
  "title": "family.yaml",
  "description": "One family: a lineage under study.",
  "type": "object",
  "required": [
    "schema",
    "id",
    "name"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/slug"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "surnames": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "places": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "period": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "integer",
        "minimum": -9999,
        "maximum": 9999
      },
      "description": "first and last year studied"
    },
    "language": {
      "$ref": "#/$defs/language"
    },
    "template": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Report template id (optimize 4.3): a file templates/<id>.html of the project, the user's, or a built-in one"
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
      "description": "BCP-47 tag, for example en, fr, fr-CA"
    }
  }
}
