{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://probandia.replit.app/schemas/proposal-1.json",
  "title": "work/proposals/<ULID>.yaml",
  "description": "What a field agent proposes; apply accepts or rejects it whole.",
  "type": "object",
  "required": [
    "schema",
    "id",
    "research",
    "pass",
    "author"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/ulid"
    },
    "research": {
      "$ref": "#/$defs/slug"
    },
    "pass": {
      "type": "integer",
      "minimum": 1
    },
    "author": {
      "$ref": "#/$defs/actor"
    },
    "persons": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/person"
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fact"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "searches": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/search"
      }
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/hypothesis"
      }
    },
    "errata": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/erratum"
      }
    },
    "refutations": {
      "type": "array",
      "description": "facts of the family found wrong: each becomes refuted, never deleted (FL-D10)",
      "items": {
        "type": "object",
        "required": [
          "fact",
          "reason",
          "cause"
        ],
        "additionalProperties": false,
        "properties": {
          "fact": {
            "$ref": "#/$defs/factid"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "cause": {
            "$ref": "#/$defs/cause"
          }
        }
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "title"
        ],
        "additionalProperties": false,
        "properties": {
          "parent": {
            "type": [
              "string",
              "null"
            ]
          },
          "kind": {
            "enum": [
              "chapter",
              "section",
              "subsection"
            ]
          },
          "title": {
            "type": "string"
          },
          "body_md": {
            "type": "string"
          },
          "facts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "places": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/place"
      }
    },
    "variants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "name",
          "form"
        ],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "surname",
              "given"
            ]
          },
          "name": {
            "type": "string"
          },
          "form": {
            "type": "string"
          },
          "source": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "non_links": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonlink"
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/gap"
      }
    },
    "analyses": {
      "type": "array",
      "description": "analyses of disputed conclusions, new or updated (GPS4)",
      "items": {
        "$ref": "#/$defs/analysis"
      }
    },
    "proofs": {
      "type": "array",
      "description": "proof arguments, new or updated (GPS5)",
      "items": {
        "$ref": "#/$defs/proof"
      }
    }
  },
  "$defs": {
    "actor": {
      "type": "object",
      "required": [
        "harness",
        "agent"
      ],
      "additionalProperties": false,
      "properties": {
        "harness": {
          "type": "string"
        },
        "agent": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "session": {
          "type": "string"
        }
      }
    },
    "cause": {
      "enum": [
        "misreading",
        "homonym",
        "faulty-index",
        "outdated-negative",
        "wrong-inference",
        "tool-failure",
        "missing-source",
        "other"
      ]
    },
    "date": {
      "type": "object",
      "required": [
        "value"
      ],
      "additionalProperties": false,
      "properties": {
        "value": {
          "$ref": "#/$defs/gendate"
        },
        "qualifier": {
          "enum": [
            "exact",
            "about",
            "before",
            "after",
            "between",
            "calculated"
          ]
        },
        "end": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/gendate"
            }
          ]
        },
        "calendar": {
          "enum": [
            "gregorian",
            "julian",
            "republican"
          ]
        },
        "original": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "day": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "erratum": {
      "type": "object",
      "required": [
        "target",
        "wrong",
        "correction",
        "cause"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^E[0-9]+$"
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "section": {
              "$ref": "#/$defs/nulid"
            },
            "fact": {
              "$ref": "#/$defs/nfactid"
            }
          }
        },
        "wrong": {
          "type": "string"
        },
        "correction": {
          "type": "string"
        },
        "cause": {
          "$ref": "#/$defs/cause"
        },
        "detection": {
          "type": [
            "string",
            "null"
          ]
        },
        "pass": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "fact": {
      "type": "object",
      "required": [
        "id",
        "type",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/factid"
        },
        "type": {
          "enum": [
            "birth",
            "baptism",
            "marriage",
            "death",
            "burial",
            "residence",
            "occupation",
            "census",
            "military",
            "emigration",
            "naturalisation",
            "other"
          ]
        },
        "date": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/date"
            }
          ]
        },
        "place": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "$ref": "#/$defs/nslug"
                },
                "as_written": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          ]
        },
        "value": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "record",
            "index",
            "hypothesis",
            "refuted"
          ]
        },
        "source": {
          "$ref": "#/$defs/nsourceid"
        },
        "evidence": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "source": {
                  "enum": [
                    "original",
                    "derivative",
                    "authored"
                  ]
                },
                "information": {
                  "enum": [
                    "primary",
                    "secondary",
                    "undetermined"
                  ]
                },
                "evidence": {
                  "enum": [
                    "direct",
                    "indirect",
                    "negative"
                  ]
                }
              }
            }
          ]
        },
        "excerpt": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "kind",
                "text",
                "sha256"
              ],
              "additionalProperties": false,
              "description": "the passage of the source this fact reads (TRUST1): lines of the transcription, or a place in a page read",
              "properties": {
                "kind": {
                  "enum": [
                    "transcription",
                    "page"
                  ]
                },
                "lines": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "description": "transcription: the first and last lines cited, from 1"
                },
                "offset": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "page: where the passage starts in the page's text, whitespace normalised"
                },
                "length": {
                  "type": "integer",
                  "minimum": 1
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500,
                  "description": "the passage itself"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$",
                  "description": "of the text, whitespace normalised"
                },
                "url": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "page: the page read"
                },
                "captured": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
                  "description": "page: the day it was read"
                },
                "region": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^([1-9][0-9]*:)?(pct:)?[0-9]+(\\.[0-9]+)?(,[0-9]+(\\.[0-9]+)?){3}$",
                  "description": "where the act is on its view (T247): x,y,w,h as iiif.region or image crop take it, in pixels, fractions of the view or pct:; n: before it, on the n-th of the source's images"
                }
              }
            },
            {
              "type": "object",
              "required": [
                "lines"
              ],
              "additionalProperties": false,
              "description": "the short form (token-economy B4): lines of the source's transcription, which propose resolves into the form above",
              "properties": {
                "source": {
                  "$ref": "#/$defs/sourceid"
                },
                "lines": {
                  "type": [
                    "string",
                    "integer"
                  ],
                  "pattern": "^ *[0-9]+ *(- *[0-9]+)? *$",
                  "description": "the first and last lines cited, such as 3-5"
                },
                "region": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^([1-9][0-9]*:)?(pct:)?[0-9]+(\\.[0-9]+)?(,[0-9]+(\\.[0-9]+)?){3}$",
                  "description": "where the act is on its view (T247): x,y,w,h as iiif.region or image crop take it, in pixels, fractions of the view or pct:; n: before it, on the n-th of the source's images"
                }
              }
            }
          ]
        },
        "uncertain_reading": {
          "type": [
            "string",
            "null"
          ]
        },
        "note": {
          "type": "string"
        },
        "research": {
          "$ref": "#/$defs/nslug"
        },
        "pass": {
          "type": [
            "integer",
            "null"
          ]
        },
        "event": {
          "$ref": "#/$defs/nulid"
        },
        "volet": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "description": "the volet open when the fact was applied (FL-D8); set by the engine, never dated back"
        },
        "refuted_in": {
          "type": "object",
          "required": [
            "pass"
          ],
          "additionalProperties": false,
          "description": "where the fact was refuted (FL-D10); set by the engine",
          "properties": {
            "pass": {
              "type": "integer",
              "minimum": 1
            },
            "volet": {
              "type": [
                "integer",
                "null"
              ]
            },
            "event": {
              "$ref": "#/$defs/nulid"
            }
          }
        }
      }
    },
    "factid": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*\\.[a-z_]+(\\.[0-9]+)?$"
    },
    "gap": {
      "type": "object",
      "required": [
        "archive",
        "window",
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^G[1-9][0-9]*$",
          "description": "given by the engine when the gap is applied (GPS3-T2)"
        },
        "archive": {
          "type": "string"
        },
        "reference": {
          "type": [
            "string",
            "null"
          ]
        },
        "window": {
          "type": "object",
          "required": [
            "from",
            "to"
          ],
          "additionalProperties": false,
          "properties": {
            "from": {
              "type": "integer"
            },
            "to": {
              "type": "integer"
            }
          }
        },
        "kind": {
          "enum": [
            "destroyed",
            "missing",
            "lacunary"
          ]
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        },
        "place": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "maxLength": 64,
          "description": "the place (places.yaml) whose records are missing"
        },
        "types": {
          "type": "array",
          "uniqueItems": true,
          "description": "the source types (catalogues/source-types.yaml) the gap concerns",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "justification": {
          "type": "string",
          "minLength": 1,
          "description": "how the gap is known: the finding aid, the archivist's answer, the inventory"
        }
      }
    },
    "gendate": {
      "type": "string",
      "pattern": "^-?[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$"
    },
    "hypothesis": {
      "type": "object",
      "required": [
        "id",
        "question",
        "hypotheses"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^h-[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "question": {
          "type": "string"
        },
        "hypotheses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "statement"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "statement": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "open",
                  "retained",
                  "rejected"
                ]
              }
            }
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "ref",
              "marks"
            ],
            "additionalProperties": false,
            "properties": {
              "ref": {
                "type": "string"
              },
              "marks": {
                "type": "object",
                "additionalProperties": {
                  "enum": [
                    "compatible",
                    "incompatible",
                    "neutral"
                  ]
                }
              }
            }
          }
        },
        "discriminating": {
          "type": [
            "string",
            "null"
          ]
        },
        "opened": {
          "$ref": "#/$defs/nday"
        },
        "closed": {
          "$ref": "#/$defs/nday"
        },
        "outcome": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "nday": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "nfactid": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*\\.[a-z_]+(\\.[0-9]+)?$"
    },
    "nonlink": {
      "type": "object",
      "required": [
        "a",
        "b",
        "reason"
      ],
      "additionalProperties": false,
      "properties": {
        "a": {
          "$ref": "#/$defs/slug"
        },
        "b": {
          "$ref": "#/$defs/slug"
        },
        "reason": {
          "type": "string"
        },
        "deciding_source": {
          "type": [
            "string",
            "null"
          ]
        },
        "decided": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "date": {
                  "$ref": "#/$defs/day"
                },
                "by": {
                  "type": "string"
                }
              }
            }
          ]
        }
      }
    },
    "nslug": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "nsourceid": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^src-[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "nulid": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "person": {
      "type": "object",
      "required": [
        "id",
        "names"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "names": {
          "type": "object",
          "required": [
            "surname"
          ],
          "additionalProperties": false,
          "properties": {
            "given": {
              "type": "string"
            },
            "surname": {
              "type": "string"
            },
            "at_birth": {
              "type": [
                "string",
                "null"
              ]
            },
            "usual": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "sex": {
          "enum": [
            "M",
            "F",
            "U"
          ]
        },
        "living": {
          "enum": [
            "auto",
            true,
            false
          ]
        },
        "parents": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "father": {
              "$ref": "#/$defs/nslug"
            },
            "mother": {
              "$ref": "#/$defs/nslug"
            }
          }
        },
        "spouses": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "person"
            ],
            "additionalProperties": false,
            "properties": {
              "person": {
                "$ref": "#/$defs/slug"
              },
              "marriage": {
                "$ref": "#/$defs/nfactid"
              }
            }
          }
        },
        "facts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fact"
          }
        }
      }
    },
    "place": {
      "type": "object",
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "names_as_written": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "current_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "type": {
          "enum": [
            "parish",
            "commune",
            "hamlet",
            "town",
            "county",
            "country"
          ]
        },
        "parent": {
          "$ref": "#/$defs/nslug"
        },
        "insee": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "code": {
                  "type": "string"
                },
                "valid_from": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "valid_to": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          ]
        },
        "gov": {
          "type": [
            "string",
            "null"
          ]
        },
        "geonames": {
          "type": [
            "string",
            "null"
          ]
        },
        "wikidata": {
          "type": [
            "string",
            "null"
          ]
        },
        "whg": {
          "type": [
            "string",
            "null"
          ]
        },
        "lat": {
          "type": [
            "number",
            "null"
          ]
        },
        "lon": {
          "type": [
            "number",
            "null"
          ]
        },
        "jurisdictions": {
          "type": "array",
          "description": "the jurisdictions the place came under, and when (GPS2)",
          "items": {
            "$ref": "#/$defs/jurisdiction"
          }
        },
        "repositories": {
          "type": "array",
          "description": "where its records are kept (GPS2)",
          "items": {
            "$ref": "#/$defs/repository"
          }
        },
        "guide": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "built": {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                },
                "sources": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "copied_from": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          ],
          "description": "when the locality guide was built, and from what (places guide)"
        }
      }
    },
    "search": {
      "type": "object",
      "required": [
        "id",
        "ts",
        "kind",
        "query",
        "result"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
