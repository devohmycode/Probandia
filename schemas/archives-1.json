{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://probandia.replit.app/schemas/archives-1.json",
  "title": "archives.yaml",
  "description": "Archives: coverage, access, witness, terms, image rights, state.",
  "type": "object",
  "required": [
    "schema",
    "archives"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": 1
    },
    "archives": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/archive"
      }
    }
  },
  "$defs": {
    "archive": {
      "type": "object",
      "required": [
        "id",
        "name",
        "nature",
        "coverage",
        "access"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "name": {
          "type": "string"
        },
        "nature": {
          "enum": [
            "image",
            "index",
            "catalogue",
            "press",
            "tree"
          ]
        },
        "reliability": {
          "type": "string"
        },
        "platform": {
          "type": "string",
          "description": "the software behind the site, as its pages show it (arkotheque, ligeo, mnesys…; other when not seen)"
        },
        "coverage": {
          "type": "object",
          "required": [
            "types",
            "places"
          ],
          "additionalProperties": false,
          "properties": {
            "types": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "years": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "integer"
              }
            },
            "places": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Z]{2}(-[0-9A-Z]{1,3})?$"
              }
            },
            "absent": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Z]{2}(-[0-9A-Z]{1,3})?$"
              }
            }
          }
        },
        "access": {
          "type": "object",
          "required": [
            "mode",
            "hosts"
          ],
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": [
                "api",
                "sru",
                "iiif",
                "html",
                "browser"
              ]
            },
            "connector": {
              "type": "string"
            },
            "third_party": {
              "enum": [
                "forbidden",
                "allowed"
              ]
            },
            "hosts": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "note": {
              "type": "string"
            }
          }
        },
        "witness": {
          "type": "object",
          "required": [
            "operation",
            "args",
            "expect"
          ],
          "additionalProperties": false,
          "properties": {
            "operation": {
              "type": "string"
            },
            "args": {
              "type": "object"
            },
            "expect": {
              "type": "object"
            }
          }
        },
        "terms": {
          "type": "string"
        },
        "image_rights": {
          "enum": [
            "free",
            "restricted",
            "mixed"
          ]
        },
        "rate": {
          "type": "string",
          "pattern": "^[1-9][0-9]*/[0-9]*(s|min|h|day)$"
        },
        "state": {
          "type": "object",
          "properties": {
            "checked": {
              "type": "string"
            },
            "note": {
              "type": "string"
            }
          }
        },
        "guide": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "string",
            "maxLength": 300
          },
          "description": "How to read the site in a browser, one step per item: the search page, how to reach a view, what to avoid. archive find shows it, and the brief of the reader hands it over"
        },
        "login": {
          "type": "object",
          "required": [
            "required"
          ],
          "additionalProperties": false,
          "description": "A site that needs a session the user opens in the browser (optimize 3.2)",
          "properties": {
            "required": {
              "type": "boolean"
            },
            "url": {
              "type": "string"
            },
            "hosts": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "identification hosts the site redirects to"
            },
            "logged_in": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "markers of a page seen while logged in"
            },
            "logged_out": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "markers of a page seen while logged out"
            },
            "session_hours": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    }
  }
}
